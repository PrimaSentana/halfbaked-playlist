---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Halfbaked Playlist",
  description = "A collaborative listening log. Search Spotify, add a track, leave your name.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link
      rel="preload"
      href="/fonts/tex-gyre-heros-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/tex-gyre-heros-bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
